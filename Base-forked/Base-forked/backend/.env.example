# Database Configuration
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/base

# CORS & Base URLs
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080","https://aayerah.com"]
PUBLIC_BASE_URL=http://localhost:8000

# Storage Backend: 'local' (development/testing) or 'supabase' (production on Render Free)
STORAGE_BACKEND=local

# Local Storage Directory (Used ONLY when STORAGE_BACKEND=local)
UPLOAD_DIR=./uploads

# Supabase Storage Configuration (Required when STORAGE_BACKEND=supabase)
# DO NOT expose the service_role key to the frontend or version control!
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_PRODUCT_IMAGES_BUCKET=product-images
SUPABASE_PRIVATE_FILES_BUCKET=private-documents

# Application Limits & Settings
MAX_IMAGE_BYTES=5242880
SESSION_HOURS=24
CURRENCY=INR
SHIPPING_FEE=20.00
GEMINI_API_KEY=
